    "@aws-sdk/client-eventbridge": "^3.1009.0",
    "@aws-sdk/lib-dynamodb": "^3.1009.0",
    "@aws-sdk/util-dynamodb": "^3.996.2"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
